# Google Gemini API Key for server-side generation (set in Render environment)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Render Backend URL for Vercel Frontend (set in Vercel environment)
# Example: https://kannadaconnect-backend.onrender.com
VITE_API_BASE_URL=

